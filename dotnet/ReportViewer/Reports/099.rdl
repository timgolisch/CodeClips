                <Paragraphs>
                  <Paragraph>
                    <TextRuns>
                      <TextRun>
                        <Value>Please disregard your recent notice to appear for a Driver Assessment reexamination scheduled on </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Times New Roman</FontFamily>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value>=IIf( IsNothing(Parameters!reexamDate.Value), Fields!reexamDate.Value,Variables!reexamDate.Value)</Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Times New Roman</FontFamily>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                        </Style>
                      </TextRun>
                      <TextRun>
                        <Value> at the Driver Assessment office in </Value>
                        <Style>
                          <FontStyle>Normal</FontStyle>
                          <FontFamily>Times New Roman</FontFamily>
                          <FontSize>12pt</FontSize>
                          <FontWeight>Normal</FontWeight>
                          <TextDecoration>None</TextDecoration>
                        </Style>
                      </TextRun>
                      <TextRun>
