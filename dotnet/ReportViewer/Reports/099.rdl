  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DASU_DEV</DataSourceName>
        <CommandText>
          SELECT tblDasuDataCurrent.DateEntered, tblDasuDataCurrent.[Type of Document], tblDasuDataCurrent.[Type of Document 2], tblDasuDataCurrent.Source, tblDasuDataCurrent.DLN,
          tblDasuDataCurrent.Title, tblDasuDataCurrent.LName, tblDasuDataCurrent.FName, tblDasuDataCurrent.MName, tblDasuDataCurrent.DOB, tblDasuDataCurrent.Sex,
          tblDasuDataCurrent.[Street Address], tblDasuDataCurrent.CityStateZip, tblDasuDataCurrent.Received, tblDasuDataCurrent.ReasonCode,
          tblDasuDataCurrent.[Original Action Codes], tblDasuDataCurrent.Received2, tblDasuDataCurrent.SecondActionCode, tblDasuDataCurrent.Reexam,
          tblDasuDataCurrent.[Referred Date], tblDasuDataCurrent.Reviewer, tblDasuDataCurrent.Reviewer2, tblDasuDataCurrent.ForwardTo, tblDasuDataCurrent.ForwardTo2,
          tblDasuDataCurrent.ReasonCode2, tblDasuDataCurrent.Pending, tblDasuDataCurrent.Cust_Phone, tblDasuDataCurrent.Cust_Email, tblDasuDataCurrent.Cust_Mail_Street,
          tblDasuDataCurrent.Cust_Mail_CityStateZip, tblDasuDataCurrent.Driver_Notes, tblDasuDataCurrent.Driver_Status_Flag, tblDasuDataCurrent.Mod_Date,
          tblDasuDataCurrent.User_Code, tblDasuPrint.PrintID, tblDasuPrint.RecordNumber, tblDasuPrint.LetterCode, tblDasuPrint.DateLetterIssued, tblDasuPrint.InitialsForLetters,
          tblDasuPrint.LetterSent, tblDasuPrint.ATTN_Title, tblDasuPrint.ATTN_FName, tblDasuPrint.ATTN_LName, tblDasuPrint.ATTN_StreetAddress, tblDasuPrint.ATTN_CityStateZip,
          tblDasuPrint.License_App_Date, tblDasuPrint.Suspend_Date, tblDasuPrint.DA_Phone, tblDasuPrint.Restrictions, tblDasuPrint.Pending_Date,
          tblDasuPrint.PhysicianStatementDate, tblDasuPrint.PhysicianLastName, tblDasuPrint.StateName, tblDasuPrint.LicStatus, tblDasuPrint.LicExpires,
          tblDasuPrint.ReexamScheduleDate, tblDasuPrint.ReexamScheduleTime, tblDasuPrint.DriverLicBureau, tblDasuPrint.ComplaintNumber, tblDasuPrint.OldRestrictions,
          tblDasuPrint.UnnecessaryRestrictions, tblDasuPrint.CrashDate, tblDasuPrint.Department, tblDasuPrint.Dept_Area, tblDasuPrint.Dept_Division, tblDasuPrint.Contact_Phone,
          tblDasuPrint.Division_Initials, tblDasuPrint.Print_Status, tblDasuPrint.Print_Date, tblDasuPrint.ATTN_StreetAddress2
          FROM     tblDasuDataCurrent INNER JOIN
          tblDasuPrint ON tblDasuDataCurrent.RecordNumber = tblDasuPrint.RecordNumber
        </CommandText>
      </Query>
